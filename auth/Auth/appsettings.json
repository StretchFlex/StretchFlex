{
  "Jwt": {
    "Issuer": "stretchflex-auth",
    "Audience": "stretchflex-api",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Database=patient_database;Username=${DB_USER};Password=${DB_PASS}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
